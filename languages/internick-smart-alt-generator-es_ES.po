msgid "Write the alt text in %s."
msgstr "Escribe el texto alternativo en %s."

#. translators: %s is the language instruction.
#: includes/class-sag-ai-provider.php:74
#, php-format
msgid "Generate a concise, descriptive alt text for this image. Maximum 125 characters. %s Return only the alt text, no quotes."
msgstr "Genera un texto alternativo conciso y descriptivo para esta imagen. Máximo 125 caracteres. %s Devuelve solo el texto alternativo, sin comillas."

#: includes/class-sag-ai-provider.php:110
msgid "The AI provider returned an empty response."
msgstr "El proveedor de IA devolvió una respuesta vacía."

