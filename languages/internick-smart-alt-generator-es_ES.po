#. Plugin Name of the plugin
#: internick-smart-alt-generator.php
msgid "Internick - Smart Alt Generator"
msgstr "Internick - Smart Alt Generator"

#. Plugin URI of the plugin
#: internick-smart-alt-generator.php
msgid "https://github.com/internick2017/smart-alt-generator"
msgstr "https://github.com/internick2017/smart-alt-generator"

#. Description of the plugin
#: internick-smart-alt-generator.php
msgid "Automatically generate descriptive alt text for images using AI. Supports WordPress 7.0 AI Connectors and OpenAI API for older versions."
msgstr "Genera automáticamente texto alternativo descriptivo para imágenes usando IA. Es compatible con los Conectores de IA de WordPress 7.0 y con la API de OpenAI en versiones anteriores."

#. Author of the plugin
#: internick-smart-alt-generator.php
msgid "Nick Granados"
msgstr "Nick Granados"

#. Author URI of the plugin
#: internick-smart-alt-generator.php
msgid "https://nickgranados.com"
msgstr "https://nickgranados.com"

