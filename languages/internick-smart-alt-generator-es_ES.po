#. Plugin Name of the plugin
#: internick-smart-alt-generator.php
msgid "AI Alt Text Generator for Images"
msgstr "Generador de texto alternativo con IA para imágenes"

#. Description of the plugin
#: internick-smart-alt-generator.php
msgid "AI alt text generator for your images. Bulk generate alt text, audit your media library, and improve accessibility and SEO."
msgstr "Generador de texto alternativo con IA para tus imágenes. Genera texto alternativo de forma masiva, audita tu biblioteca de medios y mejora la accesibilidad y el SEO."

#: includes/class-sag-image.php:83
#: includes/class-sag-image.php:227
msgid "This image format could not be converted for AI processing. Try uploading a JPEG, PNG or WebP."
msgstr "No se pudo convertir este formato de imagen para procesarlo con IA. Prueba a subir un JPEG, PNG o WebP."

#. translators: %s: the connected AI provider's name, e.g. "Anthropic".
#: build/admin-settings.js:2
#: src/admin-settings/index.js:33
#, js-format
msgid "Generating alt text via your WordPress AI Connector: %s."
msgstr "Generando texto alternativo con tu Conector de IA de WordPress: %s."

#. translators: %s: comma-separated list of connected AI providers, e.g. "Anthropic, Google".
#: build/admin-settings.js:3
#: src/admin-settings/index.js:38
#, js-format
msgid "Generating alt text via WordPress AI Connectors. Connected: %s — WordPress picks which one answers each request automatically; this plugin does not choose or know in advance."
msgstr "Generando texto alternativo con los Conectores de IA de WordPress. Conectados: %s. WordPress elige automáticamente cuál responde cada solicitud; este plugin no lo elige ni lo sabe de antemano."

#: build/admin-settings.js:3
#: src/admin-settings/index.js:54
msgid "Currently generating alt text by calling OpenAI directly with the API key below."
msgstr "Ahora mismo el texto alternativo se genera llamando directamente a OpenAI con la clave de API de abajo."

#: build/admin-settings.js:3
#: src/admin-settings/index.js:59
msgid "Running WordPress 7.0 or newer? You can connect a different AI provider (such as Anthropic or Google) in your site’s AI settings — once configured, this plugin switches to it automatically, no key or code change needed here."
msgstr "¿Tienes WordPress 7.0 o posterior? Puedes conectar otro proveedor de IA (como Anthropic o Google) en los ajustes de IA de tu sitio. Una vez configurado, este plugin cambia a él automáticamente, sin tocar aquí ninguna clave ni código."

#: build/admin-settings.js:3
#: src/admin-settings/index.js:135
msgid "Don't have a key? "
msgstr "¿No tienes una clave? "

#: build/admin-settings.js:3
#: src/admin-settings/index.js:137
msgid "Get one at platform.openai.com"
msgstr "Consíguela en platform.openai.com"

#: build/admin-settings.js:3
#: src/admin-settings/index.js:140
msgid "Billed separately from ChatGPT Plus, as pay-per-use credits — "
msgstr "Se cobra aparte de ChatGPT Plus, como créditos de pago por uso: "

#: build/admin-settings.js:3
#: src/admin-settings/index.js:142
msgid "check your OpenAI credit balance"
msgstr "consulta tu saldo de créditos de OpenAI"
